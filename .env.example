# Copy this file to .env and fill in real values. .env is gitignored.
YOUR_EMAIL=your-email@example.com
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
HEVY_API_KEY=...
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=0
# UNSW timetable subscribed feed (Mac Calendar → right-click calendar → Get Info → copy URL)
TIMETABLE_ICS_URL=
# Laptop sync scripts only (deploy/sync-data-down.sh, deploy/sync-finance-up.sh).
JARVIS_VPS_USER=
JARVIS_VPS_HOST=
# Bearer token for the agent HTTP API (agent_api.py). At least 32 characters.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# This legacy token is actor "owner" and can call every route, including
# /ask, /memory/search, and /brief.
JARVIS_API_TOKEN=
# Optional per-bot tokens. The name is the audit actor; a body "actor" is ignored.
# career: /health /flags /context /mentor /internships /today /areas
# study:  /health /flags /context /today
# money:  /health /finance /finance/* /spend /flags /today
# coach:  /health /flags /context /today /checkin /areas /schedule
# phone:  /health /events   (iOS Shortcuts: wake, gym arrival, steps, sleep)
# Edit BOT_ROUTE_ALLOWLIST in agent_api.py to grant /ask, /memory/search, or /brief.
# JARVIS_API_TOKENS=career:<token>,study:<token>,money:<token>,coach:<token>,phone:<token>
JARVIS_API_TOKENS=
# live_spend.py listen address. Leave unset to bind loopback. The iPhone Back Tap
# shortcut posts to the VPS on port 5556 — set this to all interfaces (four
# zeros) only if that shortcut must keep reaching the public address.
# JARVIS_SPEND_HOST=
# Optional daily caps for the costly agent API routes (default 30 and 100).
# JARVIS_API_ASK_DAILY=30
# JARVIS_API_MEMORY_DAILY=100
# Dollars of the Revolut balance held for someone else. Subtracted from the
# reselling cashflow balance when the savings goal is calculated, and only
# when that balance comes from finance/revolut.csv. Unset or blank counts as
# 0, so the whole Revolut balance is his. Read from the environment at
# process start (.env).
# JARVIS_REVOLUT_FRIEND_SHARE=0
# Optional: GitHub token for the portfolio area's commit evidence (areas.py).
# GITHUB_TOKEN=
# Optional gym timing (defaults 06:30, 5 min travel, 18:00 evening fallback).
# JARVIS_GYM_SLOT=06:30
# JARVIS_GYM_TRAVEL_MIN=5
# JARVIS_GYM_EVENING_SLOT=18:00
